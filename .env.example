# PostgreSQL: raw source tables (read) + ingredient_variants (write)
DATABASE_URL=postgresql://pocket_nutrition:CHANGE_ME@postgresql:5432/pocket_nutrition

# Redis: knowledge base materialised by pocket-nutrition-community (read-only)
REDIS_URL=redis://redis:6379/2

# Elasticsearch: product_search index output
ELASTICSEARCH_URL=http://elasticsearch:9200

# Trained model artifact destination
MODEL_OUTPUT_PATH=/models/model.joblib

# Elasticsearch client timeout in seconds (optional, defaults to 60)
ELASTICSEARCH_TIMEOUT=60

# Cap the number of Open Food Facts products indexed (optional, no default — unset means no cap)
#OFF_MAX_PRODUCTS=

# Number of Optuna hyperparameter search trials (optional, defaults to 20)
OPTUNA_TRIALS=20
